VITE_APP_NAME=CityFix
VITE_APP_TAGLINE=Report and track civic issues in your city.

# OpenFreeMap style id: liberty | bright | positron | dark | fiord | 3d
VITE_MAP_STYLE=liberty
# Optional override for a custom or self-hosted MapLibre style JSON URL
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_DEFAULT_LAT=49.2827
VITE_MAP_DEFAULT_LNG=-123.1207
VITE_MAP_DEFAULT_ZOOM=12

# Public API origin for the single report ingest endpoint. Leave empty until the backend is available.
VITE_API_BASE_URL=
# Optional full URL override. Defaults to {VITE_API_BASE_URL}/reports/pothole
# VITE_REPORT_INGEST_URL=
